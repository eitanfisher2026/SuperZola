rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isEditor() {
      return signedIn() && (myRole() == 'editor' || myRole() == 'admin');
    }

    // Every user's own profile. The document itself is created server-side
    // by the onUserCreate auth trigger (functions/index.js) with role:
    // 'user' — the client never creates it and never writes role, so
    // there's no client-side privilege field to defend at all. Clients may
    // only update their own non-role fields (e.g. lastLoginAt, displayName)
    // once the doc exists; admin can change anything, including role.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role);

      // A user's own tracked vendor+branch pairs for price comparison
      // (vendor, branchId, active, addedAt). Catalog data itself
      // (vendorBranches/vendorCatalogs/etc., top-level collections) is
      // server-only — the client only ever sees it through callables.
      match /vendorProfiles/{profileId} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
      // A user's own saved delivery addresses (city, street, house number,
      // geocoded lat/lng, which one is default).
      match /addresses/{addressId} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    // A list and its items belong to exactly one owner. No sharedWith.
    match /lists/{listId} {
      allow read, delete: if signedIn()
                           && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      // ownerId is immutable on update — without this, an owner could
      // rewrite their own list's ownerId to a stranger's uid and plant it
      // into that person's account (spam/harassment), since the old rule
      // only checked who owns it BEFORE the write, never that it stays the
      // same after.
      allow update: if signedIn()
                    && (resource.data.ownerId == request.auth.uid || isAdmin())
                    && request.resource.data.ownerId == resource.data.ownerId;

      match /items/{itemId} {
        allow read, write: if signedIn()
                            && (get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid
                                || isAdmin());
      }
    }

    // Shared, editor-managed reference data. Every signed-in user reads it
    // to render their own lists; only editors/admin can change it.
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isEditor();
    }
    match /vendorCategoryOrder/{vendor} {
      allow read: if signedIn();
      allow write: if isEditor();
    }
    // Which vendors have a known online-delivery branch, plus its delivery
    // terms (fee, minimum order, depot location/radius) — none of that is
    // in the regulated price feed, so it's entered by hand here.
    match /onlineVendors/{vendor} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    // Vendor/catalog data is server-only — every access goes through a
    // Cloud Function using the Admin SDK, which bypasses these rules
    // entirely. No client path ever needs read or write here.
    match /vendorBranches/{vendor}/{branchId} {
      allow read, write: if false;
    }
    match /catalogRefs/{key} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /catalogs/{key}/items/{barcode} {
      allow read, write: if false;
    }
    // Shared category tag per barcode, reused across every vendor's copy of
    // that same product. Same trust model as categories/onlineVendors below
    // — editors/admin can read and correct it directly; nobody else needs
    // (or gets) a client path to it at all.
    match /productCategories/{barcode} {
      allow read, write: if isEditor();
    }
    // When each vendor's catalog was last run through categorization —
    // editor-managed, same trust level as the tag data itself.
    match /categorizationRuns/{vendor} {
      allow read, write: if isEditor();
    }
    // A regular user's own edit of their item's category is the signal —
    // logged automatically, not something they have to "report." Writes go
    // through submitCategoryCorrection (Cloud Function) now, not a direct
    // client write — that's what makes the daily-cap rate limit possible,
    // since a plain create rule has no way to throttle. Only an editor can
    // read the queue or clear an entry once it's been reviewed.
    match /categoryCorrections/{id} {
      allow create: if false;
      allow read, delete: if isEditor();
      allow update: if false;
    }

    // Feedback conversation threads — a regular user can only see their own
    // threads; an admin can see everyone's, since that's the whole point of
    // an admin inbox. Both new threads and replies go through
    // submitFeedbackMessage (Cloud Function) now, same reasoning as
    // categoryCorrections above — rate-limiting needs a server-side check.
    match /feedbackThreads/{threadId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // App-wide AI provider/key, admin-managed — admin-only in both
    // directions, since it's a genuine secret that must never reach a
    // regular user's client. Every AI feature (categorizeItemName) reads it
    // server-side via the Admin SDK, which bypasses this rule entirely.
    match /appConfig/ai {
      allow read, write: if isAdmin();
    }

    // AI spend ledger — a user can see their own usage, never edit it.
    // Cloud Functions (Admin SDK) write it; nested by month so quota checks
    // read one small document instead of the user's whole history.
    match /costLedger/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
      match /months/{month} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    // Per-user daily call counts for the non-AI functions with a usage cap
    // (open sign-up, no allowlist, so this plus costLedger is what keeps a
    // runaway or abusive caller from being free/invisible). Same read/write
    // trust model as costLedger — a user sees their own, admin sees all,
    // nobody writes it directly (Cloud Functions only, via a transaction).
    match /usageLedger/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
      match /days/{day} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }
  }
}
